# Public site URL (used for canonical URLs, sitemaps and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Supabase (values printed by `npx supabase start` / `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used exclusively by scripts/seed.ts. Never imported by application code.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox public token (https://account.mapbox.com/access-tokens/). Required for the interactive map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Seed accounts (local development only)
SEED_ADMIN_EMAIL=admin@edumap.kg
SEED_ADMIN_PASSWORD=EduMap-Admin-2026!
SEED_USER_PASSWORD=EduMap-Parent-2026!

# Team notifications: an email to the team whenever a visitor sends a message or reports wrong information.
# Leave SMTP_HOST or NOTIFY_EMAIL_TO empty to turn it off (the admin console still lists everything).
# Local development: the Supabase mail catcher at http://127.0.0.1:56324 receives these messages.
NOTIFY_EMAIL_TO=team@edumaps.local
MAIL_FROM="EduMaps.kg <noreply@edumaps.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=56325
# Production example (use a real provider and your own domain):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Google Maps key for the school map (browser key; restrict it to your site's address in the Google Cloud console).
# With a key the school page shows a full Google map with a school-shaped pin; without one it shows Google's embedded map with Google's standard red pin.
# GOOGLE_MAPS_KEY=
# Optional: your own Map ID from the Google Cloud console (defaults to Google's DEMO_MAP_ID).
# GOOGLE_MAP_ID=
