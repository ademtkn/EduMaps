{
  "name": "edumap-kg",
  "version": "1.0.0",
  "private": true,
  "description": "EduMaps.kg - independent school discovery platform for Kyrgyzstan. A project developed and operated by Line.kg",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "start:test": "RATE_LIMIT_SCALE=50 next start -p 3100",
    "lint": "eslint .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "bash scripts/setup.sh",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint && npm run typecheck && npm run test:i18n && npm run test:import && npm run test:media && npm run test:maplinks && npm run test:db",
    "test:i18n": "tsx scripts/check-i18n.ts",
    "test:db": "tsx scripts/verify-security.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "test:import": "tsx scripts/test-import.ts",
    "media:optimize": "tsx scripts/optimize-media.ts",
    "test:media": "tsx scripts/test-media.ts",
    "test:maplinks": "tsx scripts/test-maplinks.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "mapbox-gl": "^3.33.0",
    "next": "^15.5.28",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
